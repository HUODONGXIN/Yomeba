<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java2nb.common.dao.BugLogDao">
	<select id="get" resultType="com.java2nb.common.domain.BugLogDO">
		select id,level,message,stack,url,params,ip,user_agent,gmt_create from bug_log where id = #{value}
	</select>
	<select id="list" resultType="com.java2nb.common.domain.BugLogDO">
		select id,level,message,stack,url,params,ip,user_agent,gmt_create from bug_log
		<where>
			<if test="level != null and level != ''"> and level = #{level} </if>
			<if test="message != null and message != ''"> and message like concat('%', #{message}, '%') </if>
			<if test="url != null and url != ''"> and url like concat('%', #{url}, '%') </if>
		</where>
		<choose>
			<when test="sort != null and sort.trim() != ''">order by ${sort} ${order}</when>
			<otherwise>order by id desc</otherwise>
		</choose>
		<if test="offset != null and limit != null">limit #{offset}, #{limit}</if>
	</select>
	<select id="count" resultType="int">
		select count(*) from bug_log
		<where>
			<if test="level != null and level != ''"> and level = #{level} </if>
			<if test="message != null and message != ''"> and message like concat('%', #{message}, '%') </if>
			<if test="url != null and url != ''"> and url like concat('%', #{url}, '%') </if>
		</where>
	</select>
	<insert id="save" parameterType="com.java2nb.common.domain.BugLogDO" useGeneratedKeys="true" keyProperty="id">
		insert into bug_log(level,message,stack,url,params,ip,user_agent,gmt_create)
		values(#{level},#{message},#{stack},#{url},#{params},#{ip},#{userAgent},#{gmtCreate})
	</insert>
	<delete id="remove">delete from bug_log where id = #{value}</delete>
	<delete id="batchRemove">delete from bug_log where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
	</delete>
</mapper>
